{
  "version": 1,
  "images": {
    "deviceSizes": [
      390,
      768,
      1024,
      1280,
      1920
    ],
    "imageSizes": [
      32,
      64,
      128,
      200,
      256
    ],
    "path": "/_next/image",
    "loader": "default",
    "loaderFile": "",
    "domains": [],
    "disableStaticImages": false,
    "minimumCacheTTL": 31536000,
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "maximumResponseBody": 50000000,
    "dangerouslyAllowSVG": false,
    "contentSecurityPolicy": "script-src 'none'; frame-src 'none'; sandbox;",
    "contentDispositionType": "attachment",
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "^(?:^(?:images\\.unsplash\\.com)$)$",
        "pathname": "^(?:(?!(?:^|\\/)\\.{1,2}(?:\\/|$))(?:(?:(?!(?:^|\\/)\\.{1,2}(?:\\/|$)).)*?)\\/?)$"
      }
    ],
    "unoptimized": false,
    "sizes": [
      390,
      768,
      1024,
      1280,
      1920,
      32,
      64,
      128,
      200,
      256
    ]
  }
}